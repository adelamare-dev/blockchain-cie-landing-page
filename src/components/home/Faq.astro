---
/**
 * FAQ: question/answer pairs, rendered as static HTML so the text backs the
 * FAQPage JSON-LD emitted by the page. Uses <details>/<summary> so every
 * answer stays reachable and readable without any script.
 */
import type { FaqItem } from '../../content/types';

interface Props {
  title: string;
  items: FaqItem[];
}

const { title, items } = Astro.props;
---

<section class="faq section">
  <div class="faq__inner container-text">
    <h2>{title}</h2>

    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <h3 class="faq__question-text">{item.question}</h3>
            </summary>
            <p class="faq__answer">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__inner {
    display: grid;
    gap: var(--space-md);
  }

  .faq__list {
    display: grid;
    gap: var(--space-2xs);
  }

  .faq__item {
    padding: var(--space-sm) 0;
    border-block-end: 1px solid var(--color-rule);
  }

  .faq__question {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: var(--touch-target-comfortable);
    padding-block: var(--space-3xs);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: '+';
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--color-ink-subtle);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq__item[open] .faq__question::after {
    content: '\2212';
  }

  .faq__question-text {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }

  .faq__answer {
    margin-block-start: var(--space-2xs);
    color: var(--color-ink-muted);
  }
</style>
