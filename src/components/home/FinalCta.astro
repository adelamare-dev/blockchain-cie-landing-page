---
/**
 * Final call to action: closing section, night surface, dual CTA.
 */
import type { FinalCta } from '../../content/types';
import { CALENDLY_URL, CONTACT_MAILTO } from '../../lib/links';

interface Props {
  content: FinalCta;
}

const { content } = Astro.props;
---

<section class="final-cta surface-night">
  <div class="final-cta__inner container">
    <h2 class="final-cta__title">{content.title}</h2>
    <p class="final-cta__description measure">{content.description}</p>

    <div class="final-cta__actions">
      <a class="button button--primary" href={CALENDLY_URL} data-analytics="calendly_click">
        {content.ctaPrimary}
      </a>
      <a class="button button--secondary" href={CONTACT_MAILTO} data-analytics="email_click">
        {content.ctaSecondary}
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: var(--section-gap);
  }

  .final-cta__inner {
    display: grid;
    gap: var(--space-sm);
  }

  .final-cta__description {
    color: var(--color-ink-muted);
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-sm);
  }
</style>
