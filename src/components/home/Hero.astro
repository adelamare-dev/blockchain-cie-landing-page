---
/**
 * Home hero.
 *
 * Renders the page's only <h1>. Sits on the night surface, with a primary
 * call to action to the external booking page and a secondary one that
 * scrolls to the path-choice section further down the page.
 */
import type { Hero } from '../../content/types';
import { CALENDLY_URL } from '../../lib/links';

interface Props {
  content: Hero;
}

const { content } = Astro.props;
---

<section class="hero surface-night">
  <div class="hero__inner container">
    <p class="hero__eyebrow mono-label">{content.eyebrow}</p>
    <h1 class="hero__title">{content.h1}</h1>
    <p class="hero__subtitle measure">{content.subtitle}</p>

    <div class="hero__actions">
      <a class="button button--primary" href={CALENDLY_URL} data-analytics="calendly_click">
        {content.ctaPrimary}
      </a>
      <a class="button button--secondary" href="#parcours">
        {content.ctaSecondary}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-md);
  }

  .hero__eyebrow {
    color: var(--color-night-muted);
  }

  .hero__title {
    max-width: 20ch;
  }

  .hero__subtitle {
    font-size: var(--text-md);
    color: var(--color-ink-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-sm);
  }
</style>
