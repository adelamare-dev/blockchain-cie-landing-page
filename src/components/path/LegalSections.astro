---
/**
 * Legal notice / privacy policy body: title, last-updated date, and each
 * section rendered as an h2 with its paragraphs. Long-form serif reading.
 */
interface LegalSection {
  title: string;
  body: readonly string[];
}

interface Props {
  title: string;
  updatedAt: string;
  updatedAtLabel: string;
  sections: readonly LegalSection[];
}

const { title, updatedAt, updatedAtLabel, sections } = Astro.props;
---

<article class="legal container-text section">
  <header class="legal__header">
    <h1 class="legal__title">{title}</h1>
    <p class="legal__updated mono-label">
      {updatedAtLabel} <time datetime={updatedAt}>{updatedAt}</time>
    </p>
  </header>

  <div class="legal__body">
    {
      sections.map((section) => (
        <section class="legal__section">
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))
    }
  </div>
</article>

<style>
  .legal__header {
    margin-block-end: var(--space-xl);
  }

  .legal__updated {
    margin-block-start: var(--space-sm);
  }

  .legal__body {
    display: grid;
    gap: var(--space-xl);
    font-family: var(--font-serif);
    line-height: var(--leading-relaxed);
  }

  .legal__section h2 {
    font-family: var(--font-display);
    margin-block-end: var(--space-sm);
  }

  .legal__section p + p {
    margin-block-start: var(--space-sm);
  }

  .legal__section p {
    color: var(--color-ink-muted);
  }
</style>
